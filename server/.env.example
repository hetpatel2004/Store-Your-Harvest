# AgriCold Connect - Backend Environment Variables
PORT=5000

# MongoDB Connection String (Required on Vercel: use MongoDB Atlas cloud URI)
# In MongoDB Atlas, make sure Network Access has 0.0.0.0/0 allowed!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/agricold_connect?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=agricold_connect_super_secret_jwt_key_2025_secure

# Node Environment
NODE_ENV=production

# Admin Initial Account
ADMIN_EMAIL=admin@agricold.in
ADMIN_PASSWORD=Admin@123

# Frontend URL (For CORS when deployed separately)
CLIENT_URL=https://your-frontend.vercel.app
